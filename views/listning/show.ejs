<% layout("/layouts/boilerplate") %>
<body>
  <div class="row">
    <div class="cols-8">
      <b><%= foundListing.title %></b> <br />
      <div class="card">
        <img
          src="<%= foundListing.image.url; %>"
          class="card-img-top show-img"
          alt="listing image"
          style="object-fit: cover; height: 30vh"
        />
        <div class="card-body">
          <p class="card-text">
            <b>Owned by : <%= foundListing.owner.username %></b> <br />

            <%= foundListing.description %> <br />
            <%= foundListing.price %> /Night<br />
            <%= foundListing.location %> <br />
            <%= foundListing.country %>
          </p>
          <div class="row">
            <div class="col-md-1">
              <form method="get" action="/listning/<%=foundListing._id%>/edit">
                <button class="btn btn-primary">Edit</button>
              </form>
            </div>
            <div class="col-md-1">
              <form
                method="post"
                action="/listning/<%=foundListing._id%>?_method=delete"
              >
                <button class="btn btn-danger">delete</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Reviews Section -->
    
    <% if (currentUser) { %>
    <div class="cols-8">
      <h3>Reviews</h3>
      <form
        action="/listning/<%=foundListing._id%>/review"
        method="post"
        class="needs-validation"
        novalidate
      >
        <div>
          <label for="rating" class="form-label">Rating</label>
          <input
            type="range"
            class="form-range"
            name="review[rating]"
            min="1"
            max="5"
            id="rating"
          />
        </div>
        <!-- <fieldset class="starability-slot">
          <legend>First rating:</legend>
          <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="0" checked aria-label="No rating." />
          <input type="radio" id="first-rate1" name="rating" value="1" />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input type="radio" id="first-rate2" name="rating" value="2" />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input type="radio" id="first-rate3" name="rating" value="3" />
          <label for="first-rate3" title="Average">3 stars</label>
          <input type="radio" id="first-rate4" name="rating" value="4" />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input type="radio" id="first-rate5" name="rating" value="5" />
          <label for="first-rate5" title="Amazing">5 stars</label>
      </fieldset> -->
        <div class="mb-3">
          <label for="comment" class="form-label">Comment</label>
          <textarea
            name="review[comment]"
            id="comment"
            cols="15"
            rows="3"
            class="form-control"
            required
          ></textarea>
          <div class="invalid-feedback">
            please add valid comment for Review
          </div>
        </div>
        <button class="btn btn-primary">Submit</button>
      </form>
      <% } %>

<!--Show Review Section-->

      <hr />

      <h2>Reviews</h2>
      <div class="row">
      <% for (const review of foundListing.review) { %>
        <div class="card col-5 mb-3">
          <div class="card-body">
            <h5 class="card-title">@<%= review.auther.username %></h5>
            <p class="card-text">Comment : <%= review.comment %></p>
            <p class="card-text">Rating : <%= review.rating %></p>
          </div>
          <form action="/listning/<%=foundListing._id%>/review/<%=review._id%>?_method=delete" method="post">
            <button class="btn btn-sm btn-dark mb-2 ms-2">Delete</button>
          </form>
        </div>
      <% } %>
      </div>
    </div>
  </div>
</body>
